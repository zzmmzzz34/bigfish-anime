# 复制为 config.env 后生效（start.bat 会读取）
# Bangumi 反代地址；留空则不启用 Bangumi，详情页使用 AniList 数据
# 例：BANGUMI_BASE=https://bgm.yourdomain.com
BANGUMI_BASE=

# 手机同 Wi-Fi 访问时取消注释（会监听局域网）
# HOST=0.0.0.0

# 公网隧道登录保护；留空则不启用
# AUTH_USER=bigfish
# AUTH_PASS=换成你自己的密码

# DanDanPlay 开放弹幕网络（审核通过后填）
# DANDAN_APP_ID=
# DANDAN_APP_SECRET=
# DevCenter 基础层额度（改套餐后同步修改）
# DANDAN_DAILY_LIMIT=610
# DANDAN_MONTHLY_LIMIT=14640
# 一般不用改；测试时可指向本地 mock
# DANDAN_BASE=https://api.dandanplay.net
